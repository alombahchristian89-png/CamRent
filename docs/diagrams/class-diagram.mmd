        +Number bedrooms
        +Number bathrooms
        +Number area
        +Boolean isApproved
        +Boolean isActive
        +Number views
        +Number inquiries
        +Date availableFrom
        +Date createdAt
        +Date updatedAt
    }

    class Inquiry {
        +ObjectId id
        +String message
        +String status
        +String tenantName
        +String tenantEmail
        +String tenantPhone
        +String landlordResponseMessage
        +Date landlordRespondedAt
        +Date createdAt
        +Date updatedAt
    }

    class Favorite {
        +ObjectId id
        +Date createdAt
        +Date updatedAt
    }

    User "1" --> "0..*" Property : landlord
    User "1" --> "0..*" Favorite : marks
    Property "1" --> "0..*" Favorite : favorited
    User "1" --> "0..*" Inquiry : tenant creates
    User "1" --> "0..*" Inquiry : landlord receives
