        +String profileImage
        +String phone
        +Boolean isActive
        +Date createdAt
        +Date updatedAt
        +comparePassword(candidatePassword)
        +toJSON()
    }

    class Property {
        +ObjectId id
        +String title
        +String description
        +Number price
        +String city
        +String address
        +String[] images
        +String[] amenities
        +String propertyType
